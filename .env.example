# Supabase — from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only Supabase service role key — used by API routes, the owner console,
# and the E2E test harness. NEVER use a NEXT_PUBLIC_ prefix for this value; that
# would bundle it into the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# DEPRECATED fallback: lib/supabase/admin.ts still accepts this if
# SUPABASE_SERVICE_ROLE_KEY is unset (some Vercel envs still carry it). Remove it
# once every environment is migrated to SUPABASE_SERVICE_ROLE_KEY.
# NEXT_SECRET_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry error monitoring — from sentry.io > Project > Settings > Client Keys
# DSN is safe to expose publicly; it is designed to be bundled in client code.
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
# Optional: server-only DSN (use the same value as NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz

# Sentry source-map upload — set these in CI only, not in .env.local
SENTRY_ORG  =your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Transactional email (Resend). If unset, intake link creation still succeeds
# and falls back to "copy the link"; owner-console email actions are disabled.
RESEND_API_KEY=
INTAKE_EMAIL_FROM=

# Stripe (owner-console billing). If STRIPE_SECRET_KEY is unset, all billing
# actions render a disabled state and change nothing. Server-only; never
# NEXT_PUBLIC_. STRIPE_DASHBOARD_MODE controls deep-link URLs (live | test).
STRIPE_SECRET_KEY=
STRIPE_RETENTION_COUPON_ID=
STRIPE_DASHBOARD_MODE=live

# Owner-console audit hashing. Salt for HMAC-SHA256 of request IP / user-agent
# in admin_audit_logs (so the trail is non-identifying). Set a LONG random value
# in production; a non-secret constant fallback is used if unset.
OWNER_CONSOLE_AUDIT_HASH_SALT=generate-a-long-random-value
