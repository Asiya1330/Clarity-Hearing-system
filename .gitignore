# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env*.bak

# Local test credential sheets (contain plaintext test passwords — keep .json fixture only)
/tests/fixtures/mock-tenants.csv
/tests/fixtures/mock-tenants.md

# UAT seeder run output (target URL + created user ids)
/scripts/.uat-seed-output.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/tests/.auth/
/playwright-suite.log
*.log

# Keys and secrets
*.key
secrets/

# MCP config (contains OAuth tokens — never commit)
.mcp.json
.mcp.local.json

# Claude Code local state
.claude/settings.local.json
.claude/oauth/
.claude/tokens/

# Supabase CLI local state (regenerated by `supabase link`/`start`)
supabase/.temp/
supabase/.branches/
config.bat
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
